# Bild- und Spracherkennung (Foodsharing: Regal melden, Einstellen, Abholen).
# Einen der beiden Schlüssel eintragen, Datei als .env speichern, danach `npx expo start -c`.
# Gemini (Free Tier mit Limits, Bild + Audio): https://aistudio.google.com/apikey
EXPO_PUBLIC_GEMINI_KEY=
EXPO_PUBLIC_GEMINI_MODEL=gemini-3.6-flash
# Alternativ OpenAI (Vision + Whisper): https://platform.openai.com/api-keys
EXPO_PUBLIC_OPENAI_KEY=

# Optional: eigener Übergaben-Server. Im privaten Entwicklungs-LAN automatisch Metro-IP:8787.
# Für veröffentlichte Builds expliziten HTTPS-Endpunkt konfigurieren.
# EXPO_PUBLIC_TRUST_URL=https://dein-server.example
